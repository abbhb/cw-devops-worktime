{
  "manifest_version": 3,
  "name": "CW DevOps 工时填报",
  "description": "按日期范围读取本地 Markdown 日报并批量填报 DevOps 工时，支持 Chrome 与 Edge。",
  "version": "1.0.4",
  "key": "",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://devops.cwoa.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CW DevOps 工时填报"
  },
  "options_page": "options.html"
}
